# Canonical Docker Compose configuration. Run `uv run poe configure` first.
# That command preserves existing values and generates the blank local secrets.

# Browser address and published frontend port. Keep this origin consistent in GitHub.
STACKSMITH_PLATFORM_PUBLIC_URL=http://localhost:8000
STACKSMITH_PLATFORM_BIND_ADDRESS=127.0.0.1
STACKSMITH_PLATFORM_PORT=8000
# Trust the fronting proxy when TLS terminates outside the container.
FORWARDED_ALLOW_IPS=*

# GitHub App user authorization, background execution, and webhook verification.
# Callback: http://localhost:8000/api/auth/callback
# Setup URL (enable Redirect on update): http://localhost:8000/api/auth/setup
# Webhook: <public HTTPS origin>/api/v1/webhooks/github
STACKSMITH_PLATFORM_GITHUB_CLIENT_ID=
STACKSMITH_PLATFORM_GITHUB_CLIENT_SECRET=
STACKSMITH_PLATFORM_GITHUB_APP_ID=
# Optional when App private-key credentials are available; otherwise enables installation links.
STACKSMITH_PLATFORM_GITHUB_APP_SLUG=
# Download the App's PEM file from GitHub and save it at this host path.
STACKSMITH_PLATFORM_GITHUB_PRIVATE_KEY_FILE=./.secrets/github-app.pem
# configure/check imports that PEM here for the API/worker environment.
# This file stays private (0600); Docker daemon access also exposes credentials.
STACKSMITH_PLATFORM_GITHUB_PRIVATE_KEY=
STACKSMITH_PLATFORM_ADMIN_LOGINS=[]
STACKSMITH_PLATFORM_GITHUB_WEBHOOK_SECRET=
# Optional absolute host path to a PEM bundle of additional trusted CAs.
STACKSMITH_PLATFORM_CA_BUNDLE=

# Bootstrap configuration, readable by the GitHub App installation.
# Manage shared defaults and repository inheritance under Admin settings.
STACKSMITH_PLATFORM_CONFIG=
STACKSMITH_PLATFORM_DRAFT_PULL_REQUESTS=true

# Official Stacksmith image with Python 3.15, its CLI, and its toolchain.
# stack-up builds the execution wrapper and records its immutable Docker ID.
STACKSMITH_PLATFORM_STACKSMITH_IMAGE=docker.io/cisourcerer/stacksmith:latest
# Alternatively set a prebuilt execution image as name@sha256:<digest>.
# A local sha256:<image-id> is supported by Docker, but not Kubernetes.
STACKSMITH_PLATFORM_EXECUTION_IMAGE=
STACKSMITH_PLATFORM_IMAGE=stacksmith-platform:local
STACKSMITH_PLATFORM_FRONTEND_IMAGE=stacksmith-platform-frontend:local
STACKSMITH_PLATFORM_DEBUG_IMAGE=stacksmith-platform:debug
STACKSMITH_PLATFORM_FRONTEND_DEBUG_IMAGE=stacksmith-platform-frontend:debug
STACKSMITH_PLATFORM_DEBUG_PORT=5678
# Debug-only database UI with automatic local administrator login.
STACKSMITH_PLATFORM_ADMINER_PORT=8081

# Generated by configure. Keep the encryption key stable across restarts.
STACKSMITH_PLATFORM_POSTGRES_IMAGE=postgres:18-alpine
STACKSMITH_PLATFORM_POSTGRES_PGDATA=/var/lib/postgresql/18/docker
STACKSMITH_PLATFORM_POSTGRES_DATABASE=platform
STACKSMITH_PLATFORM_SECRET_KEY=
STACKSMITH_PLATFORM_DB_PASSWORD=
STACKSMITH_PLATFORM_API_DB_PASSWORD=
STACKSMITH_PLATFORM_WORKER_DB_PASSWORD=

# Shared private artifact storage. Compose wires these to storage and workers.
STACKSMITH_PLATFORM_ARTIFACT_ACCESS_KEY=stacksmith-platform
STACKSMITH_PLATFORM_ARTIFACT_SECRET_KEY=
STACKSMITH_PLATFORM_ARTIFACT_BUCKET=stacksmith-platform

# Runtime limits and retention, in seconds.
STACKSMITH_PLATFORM_COMMAND_TIMEOUT=30
STACKSMITH_PLATFORM_PHASE_TIMEOUT=3600
STACKSMITH_PLATFORM_APPROVAL_TTL=86400
STACKSMITH_PLATFORM_ARTIFACT_RETENTION=2592000
STACKSMITH_PLATFORM_EXECUTION_CPU=1
STACKSMITH_PLATFORM_DOCKER_MEMORY=2g
STACKSMITH_PLATFORM_DOCKER_NETWORK=stacksmith-execution
# Optional JSON mapping of administrator-managed credential reference names.
STACKSMITH_PLATFORM_SECRET_REFERENCES={}
# Named secret-source instances. Only secrets with stacksmith:platform=true appear.
# Example: {"aws-prod":{"provider":"aws-secrets-manager","options":{"region":"us-east-1"}}}
STACKSMITH_PLATFORM_SECRET_SOURCES={}

# Administrator-approved, phase-scoped execution identities.
STACKSMITH_PLATFORM_EXECUTION_CREDENTIAL_PROVIDERS={}
# Provider-specific options are validated by the selected installed integration.
STACKSMITH_PLATFORM_ARTIFACT_STORE=s3
STACKSMITH_PLATFORM_ARTIFACT_OPTIONS={}
STACKSMITH_PLATFORM_RUNNER_OPTIONS={}
# For AWS sources in Compose, export AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# and AWS_SESSION_TOKEN before stack-up. These are API/worker credentials.
# STACKSMITH_RUN_ prefixed variables are sent to every run phase.
STACKSMITH_PLATFORM_RUN_ENVIRONMENT={}

# Compose uses a persistent worker. Helm selects kubernetes-jobs supervision.
STACKSMITH_PLATFORM_SUPERVISION_MODE=worker
# Maximum active inspection containers per Compose worker.
STACKSMITH_PLATFORM_INSPECTION_CONCURRENCY=4
# Inspection polling interval; maintenance and ordinary runs retain their cadence.
STACKSMITH_PLATFORM_INSPECTION_POLL_INTERVAL=2
# Each process has a bounded query pool; API notification listening uses one extra connection.
STACKSMITH_PLATFORM_DATABASE_POOL_SIZE=5
STACKSMITH_PLATFORM_DATABASE_POOL_TIMEOUT=5
# For transaction-pooled queries, put a direct/session-pooled listener URL in the configuration secret.
# STACKSMITH_PLATFORM_DATABASE_LISTENER_URL=postgresql+psycopg://...
# Optional total wait budget for isolated inspections; the command timeout is separate.
# STACKSMITH_PLATFORM_INSPECTION_WAIT_TIMEOUT=180

# Enable identity-free per-review diagnostics for performance collection.
STACKSMITH_PLATFORM_REVIEW_PROFILING=false

# Minikube PostgreSQL settings; existing PostgreSQL 17 root volumes require PGDATA=/var/lib/postgresql.
STACKSMITH_PLATFORM_MINIKUBE_POSTGRES_IMAGE=postgres:18-alpine
STACKSMITH_PLATFORM_MINIKUBE_POSTGRES_PGDATA=/var/lib/postgresql/18/docker

# Optional independent Minikube database volume; the default is stacksmith-postgres-data.
# STACKSMITH_PLATFORM_MINIKUBE_POSTGRES_VOLUME=stacksmith-postgres18-data
